# frozen_string_literal: true

=begin
  uc-zones: read-only diagnostic for the uber-combat hunting-zone picker.

  Builds the current character's live UberCombat::Character and
  UberCombat::ZoneTable, asks UberCombat::ZonePicker for its itinerary and for
  the flat union of admissible zones over the training set, then orders that
  flat list by travel distance from the current room. Issues no game command
  and mutates no picker state -- rules 1 and 2 in
  custom-scripts/uber-combat/README.md ("Rules that this code obeys").

  Distance comes from a single Room#dijkstra call made from the current room
  (map_base.rb:774, MapBase::InstanceMethods, included into Map -- and so
  into Room < Map -- by map_dr.rb:9-11). dijkstra(destination = nil) returns
  [previous, shortest_distances], both Hashes keyed by room id, not the Array
  Map.find_all_nearest_by_tag hides its distances behind (map_base.rb:887-894
  sorts by a dijkstra run it discards). One call here serves every candidate
  zone; a per-zone call would be one Dijkstra run per zone.

  Examples:
    ;uc-zones
=end

# load (not require): edits to the uber-combat lib take effect without
# restarting Lich. Same rationale as pwgo2.lic's load of powerwalk.rb.
lib_dir = File.join(SCRIPT_DIR, 'custom', 'lib')
load File.join(lib_dir, 'uc_character.rb')
load File.join(lib_dir, 'uc_zone_table.rb')
load File.join(lib_dir, 'uc_zone_picker.rb')
load File.join(lib_dir, 'uc_zone_distance.rb')
load File.join(lib_dir, 'uc_leg_settings.rb')
load File.join(lib_dir, 'uc_ferry.rb')

# Owns only presentation. All picker logic stays in the uber-combat lib; this
# class formats what the lib already computed and adds distance, which the
# lib has no reason to know about (spec: notes/uber-combat/33-zone-picker-spec.md).
class UcZonesReport
  ZONE_COL = '  %6s %8s %-24s %-9s %-12s %-18s %s'

  def initialize
    @character = UberCombat::Character.new
    @zone_table = UberCombat::ZoneTable.from_game_data

    # Same reason uc-leg.lic reads it: the premium gate needs the account
    # tier, and only the profile carries it. This diagnostic must agree with
    # uc-leg, or a zone listed as a candidate here goes missing from the
    # itinerary there with nothing to explain the difference.
    settings = get_settings
    refuse_without_weapons(settings)
    refuse_unknown_skills(settings)
    refuse_bad_creature_flags(settings)
    warn_about_max_skills(settings)
    # findpath is served from the shortest-path tree #run already computes, so
    # the whole candidate table costs ONE Dijkstra rather than one per row.
    # @previous is nil until then, and a nil tree answers "no path", which is
    # the same thing this report says about every row before it has distances.
    @ferry = UberCombat::Ferry::LiveMap.new(
      settings: settings,
      findpath: ->(from, to) { @previous && UberCombat::Ferry::LiveMap.path_from(@previous, from, to) }
    )
    @picker = UberCombat::ZonePicker.new(
      @character, @zone_table,
      UberCombat::LegSettings.premium(settings),
      province: UberCombat::LegSettings.in_province_only(settings),
      max_skills_per_leg: UberCombat::LegSettings.max_skills_per_leg(settings),
      trainable_skills: UberCombat::LegSettings.trainable_skills(settings),
      creature_flags: UberCombat::LegSettings.require_creature_flags(settings),
      distance: UberCombat::ZoneDistance.live,
      ferries: method(:ferries_for_zone)
    )
  end

  def run
    room = Room.current
    unless room
      DRC.message('uc-zones: current room is unknown; cannot compute distance.')
      return
    end

    previous, distances = room.dijkstra
    unless distances
      DRC.message('uc-zones: dijkstra failed from the current room; see the error above.')
      return
    end

    # Stashed for #ferries_for_zone, which the picker calls back into during
    # build_itinerary below and which has no other way to reach them. Set here
    # rather than in the constructor because they are a fact about where the
    # character is standing when the report runs, not about the session.
    # @previous is the same search's tree, which is what lets the ferry check
    # reconstruct any route without searching again.
    @here = room.id
    @distances = distances
    @previous = previous

    DRC.message(format('=== uc-zones: %s @ room %d, %d zones loaded ===',
                       XMLData.name, room.id, @zone_table.zones.size))
    itinerary = @picker.build_itinerary
    report_itinerary(itinerary)
    report_candidates(distances)
    report_unplaced(itinerary.unplaced)
  end

  private

  # A skill name that is not a real skill is a TYPO, not a decision. The valid
  # names are a closed set, so this is checkable, and leaving it uncheckable
  # would mean `Small Edge` reads as "I do not train Small Edged" -- the one
  # thing the person who typed it did not mean.
  def refuse_unknown_skills(settings)
    unknown = UberCombat::LegSettings.unknown_skill_names(settings)
    return if unknown.empty?

    DRC.message('uc: uc_settings names skills that do not exist. Fix these and run again:')
    unknown.each do |row|
      guess = UberCombat::LegSettings.closest_skill_name(row[:name])
      DRC.message(format('    %s: %s%s', row[:source], row[:name],
                         guess ? format('   did you mean %s', guess) : ''), false)
    end
    exit
  end

  # require_creature_flags is the guild's rule about what it may hunt, so a
  # mistake in it is fatal. A mistyped gate that was quietly dropped would send
  # an empath at living creatures or a necromancer at undead, and nothing would
  # say why.
  def refuse_bad_creature_flags(settings)
    errors = UberCombat::LegSettings.creature_flag_errors(settings)
    return if errors.empty?

    DRC.message('uc: uc_settings require_creature_flags is wrong. Fix it and run again:')
    errors.each { |line| DRC.message("    #{line}", false) }
    exit
  end

  # An empty weapons catalogue is the one catalogue error that stays fatal.
  # Omitting a weapon means "I do not train that one"; omitting all of them
  # leaves nothing to hunt with, and every leg would be built for a skill with
  # no weapon to swing. Raising here beats an itinerary of refusals.
  def refuse_without_weapons(settings)
    return unless UberCombat::LegSettings.no_weapons?(settings)

    DRC.message('uc: uc_settings has no `weapons` entries, so there is nothing to train with.')
    DRC.message('  Add at least one skill-to-weapon pair under uc_settings weapons.', false)
    DRC.message('  Leaving a weapon OUT is fine and means you do not train it.', false)
    # exit, not raise: this is a configuration mistake, and a Lich error trace
    # would bury the three lines above it that say what to do.
    exit
  end

  # A present-but-unusable max_skills_per_leg falls back to the default, which
  # is the safe direction but is also invisible. Say so once, or a person who
  # wrote `max_skills_per_leg: "3"` sees the default itinerary and concludes
  # the setting does nothing.
  def warn_about_max_skills(settings)
    return unless UberCombat::LegSettings.bad_max_skills_per_leg?(settings)

    DRC.message('uc: max_skills_per_leg must be a positive whole number. ' \
                'Ignoring it and using the default.')
  end

  def report_itinerary(itinerary)
    DRC.message('-- Itinerary (build_itinerary) --')
    if itinerary.legs.empty?
      DRC.message('  (no legs)', false)
      return
    end

    ferries = itinerary.ferry_crossings.to_h { |rec| [rec[:zone_key], rec[:detail][:crossings]] }
    itinerary.legs.each_with_index do |leg, index|
      stance = leg[:stance]
      DRC.message(format('  Leg %d: %s', index + 1, leg[:skills].join(', ')), false)
      DRC.message(format('    zone=%-24s distance=%-8s stance=%-12s defences=%s',
                         leg[:zone_key], UberCombat::ZoneDistance.label(leg[:distance]), stance[:policy],
                         @character.stance_order(stance[:policy]).join(' > ')), false)
      crossings = ferries[leg[:zone_key]]
      next unless crossings

      # Printed under the leg it belongs to rather than in a list of its own,
      # because the cost lands on that leg's every stint -- out and back.
      DRC.message(format('    ferry=%s  (bescort waits for it; the leg pays this each way)',
                         crossings.join(', ')), false)
    end
  end

  # The flat candidate list is the union, over the character's training
  # skills, of admissible_zones_for(skill) -- not the legs. A skill that
  # never leads a leg, or lost the width-clustering tie-break for a shared
  # leg, can still admit zones the itinerary never surfaces.
  def skills_by_zone_key
    index = Hash.new { |hash, key| hash[key] = [] }
    UberCombat::Character::TRAINING_SET.each do |skill|
      @picker.admissible_zones_for(skill).each { |zone| index[zone.key] << skill }
    end
    index
  end

  def report_candidates(distances)
    rows = { ranked: [], escort: [], no_tag: [], unreachable: [] }
    skills_by_zone_key.each do |zone_key, skills|
      classify(@zone_table.zone(zone_key), skills, distances, rows)
    end
    rows[:ranked].sort_by! { |row| row[:distance] }

    DRC.message('-- Candidate zones (nearest first) --')
    print_ranked(rows[:ranked])
    print_flagged('Escort access -- key is not a room tag', rows[:escort])
    print_flagged('No map tag for this zone key', rows[:no_tag])
    print_flagged('Room tag found, but every room is unreachable', rows[:unreachable])
  end

  # access: escort zones are reached by escort, not travel, and none of the
  # 18 in the current data file share a key with any room tag -- checked
  # first so they never fall through into the no_tag bucket for the wrong
  # reason.
  def classify(zone, skills, distances, rows)
    if zone.access == 'escort'
      rows[:escort] << describe(zone, skills)
      return
    end

    room_ids = Map.rooms_by_tag(zone.key)
    if room_ids.empty?
      rows[:no_tag] << describe(zone, skills)
      return
    end

    nearest = nearest_room(room_ids, distances)
    if nearest.nil?
      rows[:unreachable] << describe(zone, skills)
    else
      rows[:ranked] << describe(zone, skills).merge(room: nearest[0], distance: nearest[1])
    end
  end

  # Asked per row, and cheap: every route is reconstructed from the one
  # Dijkstra tree #run already has, and the row has already resolved the room
  # the character would actually walk to.
  def annotate_ferries(rows)
    rows.each do |row|
      row[:ferry] = ferries_between(@here, row[:room]).map(&:to_s).join(', ')
    end
  end

  # The picker's `ferries:` seam. It answers for a ZONE KEY, so resolving that
  # to a room is this script's job -- the picker knows nothing about rooms and
  # is not being taught. `method(:ferries_for_zone)` reaches a private method
  # perfectly well, and the picker only ever calls it.
  #
  # The room chosen is the one the character would actually walk to: nearest by
  # the same Dijkstra distances the candidate table is ranked on. A zone's
  # entrances can sit on opposite sides of a river, so asking about the wrong
  # one would report a crossing the trip never makes.
  #
  # DETECTION ONLY. Nothing in this script or in the picker acts on the answer;
  # it is printed and that is all (user, 2026-09-07).
  def ferries_for_zone(zone_key)
    return [] unless @here && @distances

    nearest = nearest_room(Map.rooms_by_tag(zone_key), @distances)
    return [] unless nearest

    ferries_between(@here, nearest[0])
  end

  # Never lets the ferry column be the thing that kills a report that was
  # otherwise printing fine. A route we could not price reads as no ferry.
  def ferries_between(from_id, to_id)
    @ferry.ferries(from_id, to_id) || []
  rescue StandardError => e
    DRC.message(format('uc-zones: ferry check for room %s failed (%s: %s); reporting none.',
                       to_id, e.class, e.message))
    []
  end

  def nearest_room(room_ids, distances)
    reachable = room_ids.filter_map { |id| distances[id] && [id, distances[id]] }
    reachable.min_by { |(_id, dist)| dist }
  end

  def describe(zone, skills)
    { key: zone.key, band: format('%d-%d', zone.rank_min, zone.rank_max),
      stance: @picker.stance_for(zone), skills: skills.join(', ') }
  end

  def print_ranked(rows)
    if rows.empty?
      DRC.message('  (none)', false)
      return
    end

    # FERRY is the only column here that is not a fact about the zone. DIST is
    # Dijkstra seconds and a Dijkstra second is not a wall-clock second on a
    # leg that waits for a boat, so a zone can top this list and still be the
    # slowest trip on it. A blank means the character crosses under their own
    # power or does not cross at all -- a swimmer and a passenger take
    # different map edges, and this reports the one THIS character takes.
    annotate_ferries(rows)
    DRC.message(format(ZONE_COL, 'DIST', 'ROOM', 'ZONE', 'BAND', 'STANCE', 'FERRY', 'SKILLS'), false)
    rows.each do |row|
      DRC.message(format(ZONE_COL, format('%.1f', row[:distance]), row[:room], row[:key], row[:band],
                         row[:stance], row[:ferry], row[:skills]), false)
    end
  end

  def print_flagged(label, rows)
    return if rows.empty?

    DRC.message("  -- #{label} --", false)
    rows.each do |row|
      DRC.message(format('  %-24s %-9s %-12s %s', row[:key], row[:band], row[:stance], row[:skills]), false)
    end
  end

  def report_unplaced(unplaced)
    DRC.message('-- Unplaced training skills --')
    if unplaced.empty?
      DRC.message('  (none)', false)
      return
    end

    unplaced.each do |record|
      DRC.message(format('  %-16s reason=%-20s %s', record[:skill], record[:reason], record[:detail]), false)
    end
  end
end

UcZonesReport.new.run
