=begin
  charbus library — in-process API for other Lich scripts.

  Holds only data: two bounded ring buffers and a flag. It owns no Redis
  connection; the daemon (_charbus.lic) owns both and drains these buffers.
  See notes/2026-08-14-charbus-design.md §3.3-3.5.

  Usage from any script:
    Script.loadlib('_charbus')          # resolves to lib_charbus.lic
    CharBus.emit(:died, to: 'a warcat')
    CharBus.request('Zulljin', 'start', script: 'buff')
=end

require_path = if defined?(LICH_DIR)
  File.join(LICH_DIR, 'scripts', 'custom', 'lib', 'charbus_protocol')
else
  File.expand_path('lib/charbus_protocol', File.dirname(__FILE__))
end
# `load`, not `require`: charbus_protocol.rb rebuilds CharBus::Protocol from
# scratch on every execution (its own remove_const at the top), but `require`
# only ever executes a file once per process. A prior ;lib_charbus run that
# got as far as requiring this file and then failed leaves it permanently in
# $LOADED_FEATURES, so a plain `require` here would silently no-op on every
# later run in that process and never rebuild ::Protocol.
load "#{require_path}.rb"

# Reload-safe: ;lib_charbus can be re-run. Buffers are plain data, so an
# orphaned one is harmless — but see the daemon's re-resolution requirement.
#
# Do NOT remove_const(:CharBus) here: charbus_protocol.rb already resets the
# whole CharBus constant (including ::Protocol) the first time it's required,
# and require is a no-op on any later reload. Nuking :CharBus again at this
# point would take ::Protocol down with it, since it lives on the same
# top-level constant -- reopening the module below is sufficient to reset
# @buffer/@outbox/@present on reload without touching Protocol.
module ::CharBus
  EVENT_CAPACITY   = 256
  OUTBOX_CAPACITY  = 64

  @buffer  = CharBus::Protocol::RingBuffer.new(EVENT_CAPACITY)
  @outbox  = CharBus::Protocol::RingBuffer.new(OUTBOX_CAPACITY)
  @present = false

  class << self
    attr_reader :buffer, :outbox

    def daemon_present? = @present

    def daemon_present=(val)
      @present = !!val
    end

    # Never blocks, never raises, never touches a socket. A hunting script
    # must not stall or die because Redis blinked.
    def emit(event, **fields)
      @buffer.push({ "event" => event.to_s, "at" => Time.now.to_f, "fields" => stringify(fields) })
      :queued
    rescue StandardError
      :queued
    end

    # Peer-to-peer. Returns :bus_down so a caller can react rather than
    # assume delivery — with no daemon there is nothing to publish it.
    def request(character, verb, **args)
      return :bus_down unless @present

      @outbox.push({
        "character" => character.to_s,
        "verb"      => verb.to_s,
        "args"      => stringify(args),
        "at"        => Time.now.to_f
      })
      :queued
    rescue StandardError
      :bus_down
    end

    def stringify(hash)
      hash.each_with_object({}) { |(k, v), h| h[k.to_s] = v }
    end
  end
end
