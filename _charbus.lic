=begin
  charbus daemon. See notes/2026-08-14-charbus-design.md.

  Named with a leading underscore so Lich's prefix matcher (;p c, ;p char)
  cannot reach it -- see §3.1. Do not rename without reading that section.
=end

require 'redis'
require 'securerandom'

Script.loadlib('_charbus')   # -> lib_charbus.lic

me = Script.current
# Also as a global: `me` is a top-level local, and `def` bodies open a new
# scope that cannot see it. Verb code lives in defs and must never call
# Script.current, which sleeps while the script is paused.
$charbus_me = me
unless (daemon = Script.daemon_me)
  respond '--- charbus: cannot identify calling script; aborting.'
  exit
end
_ = daemon

INSTANCE = SecureRandom.hex(3)

# Channel names depend on XMLData.name, which is empty until the <app char=>
# tag arrives. Starting before then would put every character on dr:_state.
# Use .to_s.empty? -- line 929 of xmlparser.rb assigns @name unconditionally for
# any <app> tag, so a tag without a char attribute sets it to nil (§6.6).
unless XMLData.name.to_s.empty?
  # already logged in
else
  respond '--- charbus: waiting for login before claiming a channel...'
  waited = 0
  while XMLData.name.to_s.empty?
    sleep 1
    waited += 1
    respond '--- charbus: still waiting for character name...' if (waited % 30).zero?
  end
end
CHARACTER = XMLData.name.to_s.dup.freeze

raw_config = get_data('charbus')
begin
  CONFIG = CharBus::Protocol::Config.validate!(
    CharBus::Protocol::Config.for_character(raw_config, CHARACTER)
  )
rescue CharBus::Protocol::ConfigError => e
  # Lich's loader rescues every YAML parse error and returns {}, so a malformed
  # config is indistinguishable from a missing one without this check (§7).
  respond "--- charbus: #{e.message}"
  respond '--- charbus: expected lich-5/scripts/data/custom/base-charbus.yaml'
  exit
end

PREFIX          = CONFIG['channel_prefix']
STATE_CHANNEL   = CharBus::Protocol::Channels.state(PREFIX, CHARACTER)
REQUEST_CHANNEL = CharBus::Protocol::Channels.requests(PREFIX, CHARACTER)

def redis_options(cfg)
  r = cfg['redis']
  {
    host: r['host'], port: r['port'], db: r['db'],
    connect_timeout: r['connect_timeout'], read_timeout: r['read_timeout'],
    reconnect_attempts: r['reconnect_attempts']
  }.compact
end

# Fail loud at startup: an unreachable Redis exits rather than retrying quietly.
begin
  $charbus_pub = Redis.new(**redis_options(CONFIG))
  $charbus_pub.ping
rescue StandardError => e
  # Close before exiting. before_dying is registered further down and never
  # runs on this path, so a ping that fails *after* the socket opened (accepted
  # TCP, then a read timeout or handshake error) would strand it for the life
  # of the Lich process -- once per retried ;_charbus.
  $charbus_pub&.close rescue nil
  $charbus_pub = nil
  respond "--- charbus: cannot reach Redis at #{CONFIG['redis']['host']}:#{CONFIG['redis']['port']} (#{e.class})"
  exit
end
$charbus_sub = Redis.new(**redis_options(CONFIG))

CharBus.daemon_present = true
respond "--- charbus: #{CHARACTER} on #{STATE_CHANNEL} (instance #{INSTANCE})"

before_dying do
  CharBus.daemon_present = false
  $charbus_sub&.close rescue nil
  $charbus_pub&.close rescue nil
end

$charbus_seq = 0
$charbus_seq_mutex = Mutex.new

def next_seq
  $charbus_seq_mutex.synchronize { $charbus_seq += 1 }
end

def publish(type, payload, reply_to: nil, channel: STATE_CHANNEL)
  json = CharBus::Protocol::Envelope.encode(
    type: type, from: CHARACTER, instance: INSTANCE, seq: next_seq,
    reply_to: reply_to, payload: CharBus::Protocol::Sanitize.deep(payload)
  )
  $charbus_pub.publish(channel, json)
  true
rescue StandardError
  false
end

def emit_event(name, fields = {})
  publish('event', { 'event' => name.to_s }.merge(fields))
end

def snapshot_fast
  {
    'vitals' => {
      'health' => DRStats.health, 'mana' => DRStats.mana,
      'fatigue' => DRStats.fatigue, 'spirit' => DRStats.spirit,
      'concentration' => DRStats.concentration
    },
    # encumbrance and position are drinfomon class variables, not XMLData
    # delegates; encumbrance is nil until first parsed. position is COMBAT
    # ADVANTAGE, not posture.
    'encumbrance' => DRStats.encumbrance,
    'combat_position' => DRStats.position,
    'location' => {
      'room_id' => XMLData.room_id.to_s,
      'room_title' => XMLData.room_title.to_s
    },
    'scripts' => Script.list.map { |s| { 'name' => s.name, 'paused' => s.paused?, 'hidden' => s.hidden } },
    'dropped_events' => CharBus.buffer.dropped
  }
end

def snapshot_slow
  skills = {}
  DRSkill.list.each do |s|
    skills[s.name] = { 'rank' => s.rank, 'exp' => s.exp, 'percent' => s.percent }
  end
  # No coins field. There is no passive accessor: the only way to read wealth
  # is DRC.bput("wealth ...") / Lich::Util.issue_command('wealth', ...), which
  # SENDS A GAME COMMAND. A heartbeat must never do that -- it would type
  # "wealth" into the game every slow_interval, forever, per character. Same
  # principle as using XMLData over Room.current: a state feed observes, it
  # does not act. If coins are wanted later they belong behind an explicit
  # request verb, where the cost is the caller's choice.
  { 'skills' => skills }
end

ticker = CharBus::Protocol::Ticker.new(
  fast_interval: CONFIG['heartbeat']['fast_interval'],
  slow_interval: CONFIG['heartbeat']['slow_interval']
)

publisher = Thread.new do
  loop do
    begin
      ticker.due.each do |tier|
        case tier
        when :fast then publish('heartbeat_fast', snapshot_fast)
        when :slow then publish('heartbeat_slow', snapshot_slow)
        end
      end

      # Re-resolve the buffer every iteration. ;lib_charbus rebinds CharBus to a
      # fresh module; a cached buffer would be drained forever while emitters
      # filled the new one, silently (§3.4).
      max_age = CONFIG['event_max_age']
      now = Time.now.to_f
      CharBus.buffer.drain.each do |ev|
        next if now - ev['at'].to_f > max_age
        publish('event', { 'event' => ev['event'] }.merge(ev['fields']))
      end
    rescue StandardError => e
      respond "--- charbus: publisher error #{e.class}: #{e.message}"
    end
    sleep 0.25
  end
end

$charbus_requests     = SizedQueue.new(CONFIG['queue_size'])
$charbus_ping_replies = Queue.new
$charbus_stopping     = false

def handle_inbound(json)
  msg = CharBus::Protocol::Envelope.decode(json)

  # Version guard reads id/reply_to from the ENVELOPE, so it can answer a
  # message whose payload layout it cannot assume (§4.2).
  if msg[:v] != CharBus::Protocol::VERSION
    if msg[:reply_to]
      publish('reply', { 'in_reply_to' => msg[:id], 'error' => 'unsupported_version' },
              channel: msg[:reply_to])
    end
    return
  end

  verb = msg[:payload]['verb']

  if verb == 'ping'
    nonce = msg[:payload].dig('args', 'nonce')
    if msg[:instance] == INSTANCE
      $charbus_ping_replies << nonce            # our own ping came back
    elsif msg[:reply_to]
      publish('reply', { 'in_reply_to' => msg[:id], 'nonce' => nonce,
                         'instance' => INSTANCE, 'at' => Time.now.to_f },
              channel: msg[:reply_to])
    end
    # A ping from a DIFFERENT instance on our own request channel means a twin.
    if msg[:instance] != INSTANCE && msg[:from] == CHARACTER
      respond '--- charbus: WARNING another daemon is live for this character'
      emit_event('duplicate_daemon', 'other_instance' => msg[:instance])
    end
    return
  end

  msg[:arrived_at] = Time.now.to_f
  begin
    $charbus_requests.push(msg, true)
  rescue ThreadError
    emit_event('request_failed', 'id' => msg[:id], 'error' => 'queue_full')
    if msg[:reply_to]
      publish('reply', { 'in_reply_to' => msg[:id], 'error' => 'queue_full' },
              channel: msg[:reply_to])
    end
  end
rescue CharBus::Protocol::MalformedEnvelope
  nil   # unparseable envelope is the only case dropped silently
end

subscriber = Thread.new do
  backoff = CONFIG['reconnect_backoff']
  attempt = 0
  until $charbus_stopping
    begin
      # Plain blocking subscribe, NOT subscribe_with_timeout: the timeout
      # variant tears down and rebuilds the pubsub connection every cycle,
      # dropping inbound messages in the gap (§6.4).
      $charbus_sub.subscribe(REQUEST_CHANNEL) do |on|
        on.message { |_ch, json| handle_inbound(json) }
      end
      attempt = 0
    rescue IOError, Errno::EBADF
      break if $charbus_stopping   # deliberate teardown, not a fault
      attempt += 1
    rescue StandardError => e
      break if $charbus_stopping
      delay = backoff[[attempt, backoff.size - 1].min]
      attempt += 1
      respond "--- charbus: subscriber lost (#{e.class}); retrying in #{delay}s"
      sleep delay
      begin
        $charbus_sub = Redis.new(**redis_options(CONFIG))
        emit_event('bus_reconnected', 'attempt' => attempt)
        respond '--- charbus: subscriber reconnected'
      rescue StandardError
        nil
      end
    end
  end
end

SCRIPT_NAME_RE = /\A[\w.-]+\z/

def reply_ok(msg, data = {})
  return unless msg[:reply_to]
  publish('reply', { 'in_reply_to' => msg[:id], 'ok' => true }.merge(data), channel: msg[:reply_to])
end

def reply_err(msg, error)
  emit_event('request_failed', 'id' => msg[:id], 'error' => error)
  return unless msg[:reply_to]
  publish('reply', { 'in_reply_to' => msg[:id], 'ok' => false, 'error' => error },
          channel: msg[:reply_to])
end

# Never hand an unvalidated string to Lich's matchers: Script.kill interpolates
# into /^#{name}$/i unescaped and pause_script's /^#{scr}/i is unanchored.
def resolve_running(name)
  return nil unless name.is_a?(String) && name.match?(SCRIPT_NAME_RE)
  Script.list.find { |s| s.name.casecmp?(name) }
end

def execute(msg)
  args = msg[:payload]['args'] || {}
  case msg[:payload]['verb']
  when 'start'
    name = args['script']
    return reply_err(msg, 'invalid_script_name') unless name.is_a?(String) && name.match?(SCRIPT_NAME_RE)
    return reply_err(msg, 'no_such_script') unless Script.exists?(name)

    started = start_script(name, Array(args['args']).map(&:to_s))
    started ? reply_ok(msg, 'started' => name) : reply_err(msg, 'start_failed')

  when 'stop'
    target = resolve_running(args['script'])
    return reply_err(msg, 'no_such_script') unless target
    # Compare against the latched script object, NOT Script.current: that
    # sleeps while the script is paused (script.rb:1025-1027). A `stop`
    # aimed at the daemon arriving while it is paused would park the single
    # worker inside Script.current -- and the only thing that could unpause
    # it is a `resume` verb dequeued by that same wedged worker.
    emit_event('daemon_stopped', 'reason' => 'remote_stop') if target.name == $charbus_me.name
    Script.kill(target.name) ? reply_ok(msg, 'stopped' => target.name) : reply_err(msg, 'stop_failed')

  when 'pause'
    target = resolve_running(args['script'])
    return reply_err(msg, 'no_such_script') unless target
    target.pause
    reply_ok(msg, 'paused' => target.name)

  when 'resume'
    target = resolve_running(args['script'])
    return reply_err(msg, 'no_such_script') unless target
    target.unpause
    reply_ok(msg, 'resumed' => target.name)

  when 'send'
    text = args['text']
    return reply_err(msg, 'missing_text') unless text.is_a?(String) && !text.empty?
    put text
    reply_ok(msg, 'sent' => text)

  when 'expect'
    text    = args['text']
    pattern = args['pattern']
    timeout = args['timeout'].to_i
    return reply_err(msg, 'missing_args') unless text.is_a?(String) && pattern.is_a?(String)
    return reply_err(msg, 'timeout_too_large') if timeout > CONFIG['expect_max_timeout'] || timeout <= 0

    deadline = Time.now.to_f + CONFIG['expect_max_timeout']
    result = dothistimeout(text, timeout, Regexp.new(pattern))
    reply_ok(msg, 'matched' => result.to_s, 'overran' => Time.now.to_f > deadline)

  when 'query'
    fields = Array(args['fields'])
    snap = snapshot_fast.merge(snapshot_slow)
    snap = snap.slice(*fields) unless fields.empty?
    reply_ok(msg, 'snapshot' => CharBus::Protocol::Sanitize.deep(snap))

  else
    reply_err(msg, 'unknown_verb')
  end
end

worker = Thread.new do
  loop do
    msg = $charbus_requests.pop
    break if msg.nil?

    begin
      if Time.now.to_f - msg[:arrived_at] > CONFIG['request_max_age']
        emit_event('request_expired', 'id' => msg[:id])
        publish('reply', { 'in_reply_to' => msg[:id], 'ok' => false, 'error' => 'expired' },
                channel: msg[:reply_to]) if msg[:reply_to]
        next
      end
      execute(msg)
    rescue StandardError => e
      # The worker may never die from a request: an unrescued exception kills
      # the thread silently while heartbeats keep flowing (§6.1).
      reply_err(msg, "#{e.class}: #{e.message}")
    end
  end
end

sleep 1   # replaced by the supervisor loop in Task 10
